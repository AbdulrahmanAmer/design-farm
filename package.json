{
  "name": "design-farm",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A farm of design languages: facet tokens (palette, depth, shape, type, density), a remixable React component library, and the harvest tooling that grows it from reference images.",
  "main": "ui/index.ts",
  "scripts": {
    "postinstall": "node tools/setup.mjs",
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/setup.mjs --check",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "palette": "python -I tools/palette.py",
    "curve": "node tools/curve.mjs",
    "shoot": "node tools/shoot.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
